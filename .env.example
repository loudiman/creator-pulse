# Real file lives at /etc/creatorpulse/creatorpulse.env, root:root, chmod 600 (D-04).
# This template is committed; the real file with real values is never committed.

# YouTube Data API v3
YOUTUBE_API_KEY=

# Twitch Helix (app access token via client credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord bot + webhook
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Google Sheets (service account) — the spreadsheet key from the Sheet's own URL, and an
# absolute path to the service-account JSON on the droplet (e.g. /etc/creatorpulse/sheets-key.json).
# Real values live only in /etc/creatorpulse/creatorpulse.env, chmod 600 (D-09).
CREATORPULSE_SHEET_ID=
CREATORPULSE_SHEETS_KEYFILE=
